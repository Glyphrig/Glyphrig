---
import { withBase } from '../lib/data.js';
---

<dialog
  id="glyphrig-search-dialog"
  class="glyphrig-dialog"
  aria-labelledby="glyphrig-search-title"
  data-pagefind-url={withBase('pagefind/pagefind.js')}
  data-feed-url={withBase('feed.json')}
>
  <div class="dialog-head">
    <h2 id="glyphrig-search-title" class="dialog-title">Search Bookmarks</h2>
    <button type="button" class="pill-btn" data-close-search>Close (Esc)</button>
  </div>
  <div class="dialog-body">
    <div class="field">
      <label for="glyphrig-search-input">Keywords, domain, or tags</label>
      <input
        id="glyphrig-search-input"
        type="search"
        placeholder="Type to search bookmarks…"
        autocomplete="off"
      />
    </div>
    <p id="glyphrig-search-status" class="status-note">Type a query to search across all folders.</p>
    <div id="glyphrig-search-results" class="search-results"></div>
  </div>
</dialog>

<script>
  interface PagefindApi {
    init?: () => Promise<void>;
    search: (term: string) => Promise<{
      results: Array<{ data: () => Promise<{ url: string; meta?: { title?: string }; excerpt?: string }> }>;
    }>;
  }

  interface FeedItem {
    url: string;
    title?: string;
    content_text?: string;
    tags?: string[];
  }

  const dialog = document.getElementById('glyphrig-search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('glyphrig-search-input') as HTMLInputElement | null;
  const statusEl = document.getElementById('glyphrig-search-status');
  const resultsEl = document.getElementById('glyphrig-search-results');

  let pagefindInstance: PagefindApi | null = null;
  let feedFallback: FeedItem[] | null = null;
  let loadPromise: Promise<void> | null = null;

  function isSafeHref(raw: string): boolean {
    if (!raw) return false;
    if (raw.startsWith('/') && !raw.startsWith('//')) return true;
    try {
      const parsed = new URL(raw, window.location.origin);
      return parsed.protocol === 'https:' || parsed.protocol === 'http:';
    } catch {
      return false;
    }
  }

  function appendSafeExcerpt(container: HTMLElement, rawText: string, allowMarkTags: boolean): void {
    if (!allowMarkTags) {
      container.textContent = rawText;
      return;
    }
    const parser = new DOMParser();
    const doc = parser.parseFromString(`<div>${rawText}</div>`, 'text/html');
    const root = doc.body.firstElementChild;
    if (!root) {
      container.textContent = rawText;
      return;
    }
    const walk = (node: Node, target: HTMLElement): void => {
      for (const child of Array.from(node.childNodes)) {
        if (child.nodeType === Node.TEXT_NODE) {
          target.append(document.createTextNode(child.textContent ?? ''));
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          const el = child as Element;
          if (el.tagName.toLowerCase() === 'mark') {
            const mark = document.createElement('mark');
            mark.textContent = el.textContent ?? '';
            target.append(mark);
          } else {
            walk(el, target);
          }
        }
      }
    };
    walk(root, container);
  }

  async function ensureSearchBackend(): Promise<void> {
    if (!dialog) return;
    if (!loadPromise) {
      loadPromise = (async () => {
        const pagefindUrl = dialog.dataset.pagefindUrl || '/pagefind/pagefind.js';
        try {
          const mod = (await import(/* @vite-ignore */ pagefindUrl)) as PagefindApi;
          if (mod.init) await mod.init();
          pagefindInstance = mod;
        } catch {
          const feedUrl = dialog.dataset.feedUrl || '/feed.json';
          try {
            const res = await fetch(feedUrl);
            if (res.ok) {
              const json = (await res.json()) as { items?: FeedItem[] };
              feedFallback = json.items ?? [];
            }
          } catch {
            feedFallback = [];
          }
        }
      })();
    }
    return loadPromise;
  }

  function renderEntries(
    entries: Array<{ title: string; href: string; snippet: string; allowMark?: boolean }>,
  ): void {
    if (!resultsEl || !statusEl) return;
    resultsEl.textContent = '';
    const safeEntries = entries.filter((e) => isSafeHref(e.href));
    if (safeEntries.length === 0) {
      statusEl.textContent = 'No matching bookmarks found.';
      return;
    }
    statusEl.textContent = `${safeEntries.length} result${safeEntries.length === 1 ? '' : 's'}`;
    for (const item of safeEntries) {
      const link = document.createElement('a');
      link.className = 'search-result-card';
      link.href = item.href;
      const strong = document.createElement('strong');
      strong.textContent = item.title;
      const snippet = document.createElement('div');
      snippet.className = 'status-note';
      appendSafeExcerpt(snippet, item.snippet, Boolean(item.allowMark));
      link.append(strong, snippet);
      resultsEl.append(link);
    }
  }

  let debounceHandle: number | undefined;

  input?.addEventListener('input', () => {
    window.clearTimeout(debounceHandle);
    debounceHandle = window.setTimeout(async () => {
      const q = input.value.trim();
      if (!q) {
        if (resultsEl) resultsEl.textContent = '';
        if (statusEl) statusEl.textContent = 'Type a query to search across all folders.';
        return;
      }

      await ensureSearchBackend();
      if (pagefindInstance) {
        const search = await pagefindInstance.search(q);
        const top = search.results.slice(0, 15);
        const resolved = await Promise.all(top.map((r) => r.data()));
        renderEntries(
          resolved.map((r) => ({
            title: r.meta?.title || r.url,
            href: r.url,
            snippet: r.excerpt || r.url,
            allowMark: Boolean(r.excerpt),
          })),
        );
        return;
      }

      const lower = q.toLowerCase();
      const matched = (feedFallback ?? [])
        .filter((item) => {
          const hay = `${item.title ?? ''} ${item.url} ${item.content_text ?? ''} ${(item.tags ?? []).join(' ')}`.toLowerCase();
          return hay.includes(lower);
        })
        .slice(0, 15)
        .map((item) => ({
          title: item.title || item.url,
          href: item.url,
          snippet: item.content_text || item.url,
          allowMark: false,
        }));
      renderEntries(matched);
    }, 120);
  });

  function openSearch(): void {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    input?.focus();
    void ensureSearchBackend();
  }

  document.querySelectorAll('[data-open-search]').forEach((el) => {
    el.addEventListener('click', openSearch);
  });
  document.querySelectorAll('[data-close-search]').forEach((el) => {
    el.addEventListener('click', () => dialog?.close());
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  window.addEventListener('keydown', (e) => {
    const tag = (document.activeElement?.tagName || '').toLowerCase();
    const editing = tag === 'input' || tag === 'textarea' || tag === 'select';
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    } else if (!editing && e.key === '/') {
      e.preventDefault();
      openSearch();
    }
  });
</script>
