---
import type { EnrichedBookmark } from '../types.js';
import {
  contributorHref,
  folderHref,
  isSafeHttpUrl,
  siteData,
  tagHref,
  withBase,
} from '../lib/data.js';

interface Props {
  bookmark: EnrichedBookmark;
  showFolder?: boolean;
}

const { bookmark, showFolder = false } = Astro.props;
const tagSlugMap = new Map(siteData.tags.map((t) => [t.tag, t.slug]));
const contributorSlugMap = new Map(siteData.contributors.map((c) => [c.username, c.slug]));
const monogram = (bookmark.domain || '?').replace(/^www\./, '').charAt(0).toUpperCase() || '?';
const contributorNoteEntries = bookmark.contributorNotes
  ? Object.entries(bookmark.contributorNotes).sort((a, b) => a[0].localeCompare(b[0]))
  : [];
const safeHref = isSafeHttpUrl(bookmark.url) ? bookmark.url : undefined;
const safeOgImage = isSafeHttpUrl(bookmark.ogImage) ? bookmark.ogImage : undefined;
const safeWaybackUrl = isSafeHttpUrl(bookmark.waybackUrl) ? bookmark.waybackUrl : undefined;
---

<article
  class="bookmark-item"
  data-tags={bookmark.tags.join(',')}
  data-contributors={bookmark.globalSavedBy.join(',')}
  data-added={bookmark.added ?? ''}
  data-url={bookmark.normalizedUrl}
  data-bookmark-item
>
  <div class:list={['bm-og-wrap', { 'is-empty': !safeOgImage }]}>
    {safeOgImage ? (
      <img
        src={safeOgImage}
        alt=""
        class="bm-og-img"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span>{bookmark.domain}</span>
    )}
  </div>

  <div class="bm-body">
    <div class="bm-row-top">
      <div class="bm-title-group">
        {bookmark.faviconPath ? (
          <img
            src={withBase(bookmark.faviconPath)}
            alt=""
            width="16"
            height="16"
            class="bm-favicon"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="bm-monogram" aria-hidden="true">{monogram}</span>
        )}
        {safeHref ? (
          <a
            href={safeHref}
            class="bm-link"
            target="_blank"
            rel="noopener noreferrer"
            data-bm-anchor
          >
            {bookmark.title}
          </a>
        ) : (
          <span class="bm-link">{bookmark.title}</span>
        )}
      </div>
      <span class="bm-domain">{bookmark.domain}</span>
    </div>

    {bookmark.effectiveDescription && (
      <p class="bm-desc">{bookmark.effectiveDescription}</p>
    )}

    {contributorNoteEntries.length > 0 && (
      <ul class="bm-contributor-notes" aria-label="Contributor notes">
        {contributorNoteEntries.map(([username, text]) => {
          const slug = contributorSlugMap.get(username);
          return (
            <li class="bm-contributor-note">
              {slug ? (
                <a href={contributorHref(slug)} class="bm-note-author">
                  @{username}
                </a>
              ) : (
                <span class="bm-note-author">@{username}</span>
              )}
              <span class="bm-note-sep">:</span>{' '}
              <span>{text}</span>
            </li>
          );
        })}
      </ul>
    )}

    <div class="bm-meta">
      {bookmark.popularity > 0 && (
        <span
          class="bm-popularity"
          title={`Saved by ${bookmark.globalSavedBy.map((u) => `@${u}`).join(', ')}`}
        >
          ★ {bookmark.popularity}
        </span>
      )}
      {showFolder && (
        <a href={folderHref(bookmark.folderPath)} class="bm-folder-badge">
          {bookmark.folderTitle}
        </a>
      )}
      {bookmark.tags.map((tag) => {
        const slug = tagSlugMap.get(tag) ?? encodeURIComponent(tag);
        return (
          <a href={tagHref(slug)} class="bm-tag">
            #{tag}
          </a>
        );
      })}
      {bookmark.globalSavedBy.map((username) => {
        const slug = contributorSlugMap.get(username);
        return slug ? (
          <a href={contributorHref(slug)} class="bm-contributor">
            @{username}
          </a>
        ) : (
          <span class="bm-contributor">@{username}</span>
        );
      })}
      {bookmark.linkStatus === 'dead' && (
        <span
          class="bm-dead-badge"
          title={bookmark.httpStatus ? `HTTP ${bookmark.httpStatus}` : 'URL could not be reached'}
        >
          Link offline
        </span>
      )}
      {safeWaybackUrl && (
        <a
          href={safeWaybackUrl}
          class="bm-archive-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Archived snapshot
        </a>
      )}
      {bookmark.added && <span class="bm-date">{bookmark.added}</span>}
    </div>
  </div>
</article>
