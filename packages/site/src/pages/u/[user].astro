---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookmarkItem from '../../components/BookmarkItem.astro';
import ViewControls from '../../components/ViewControls.astro';
import {
  collectTagsInBookmarks,
  contributorFeedHref,
  deduplicateBookmarksByUrl,
  siteData,
  sortRecentBookmarks,
  withBase,
} from '../../lib/data.js';
import type { ContributorSummary } from '../../types.js';

export function getStaticPaths() {
  return siteData.contributors.map((summary) => ({
    params: { user: summary.slug },
    props: { summary },
  }));
}

interface Props {
  summary: ContributorSummary;
}

const { summary } = Astro.props;
const bookmarks = sortRecentBookmarks(
  deduplicateBookmarksByUrl(
    siteData.allBookmarks.filter((b) => b.globalSavedBy.includes(summary.username)),
  ),
);
const tags = collectTagsInBookmarks(bookmarks);
const feedUrl = contributorFeedHref(summary.slug);
---

<BaseLayout
  title={`@${summary.username}`}
  description={`Bookmarks saved by @${summary.username}`}
  activeNav="contributors"
  indexForSearch={false}
  extraFeed={{ title: `@${summary.username} RSS`, href: feedUrl }}
>
  <nav class="breadcrumbs" aria-label="Breadcrumbs">
    <a href={withBase('')}>{siteData.root.title || 'Home'}</a>
    <span aria-hidden="true">/</span>
    <a href={withBase('u/')}>Contributors</a>
    <span aria-hidden="true">/</span>
    <span>@{summary.username}</span>
  </nav>

  <header class="page-header">
    <div class="page-header-row">
      <h1 class="page-title">@{summary.username}</h1>
      <a href={feedUrl} class="feed-pill" title={`RSS feed for @${summary.username}`}>
        RSS
      </a>
    </div>
    <p class="page-subtitle">
      {bookmarks.length} unique bookmark{bookmarks.length === 1 ? '' : 's'}
    </p>
  </header>

  <ViewControls tags={tags} />

  <div
    class="bookmark-collection"
    data-bookmark-collection
    data-view={siteData.config.theme.defaultView}
  >
    {bookmarks.map((bm) => (
      <BookmarkItem bookmark={bm} showFolder={true} />
    ))}
  </div>
</BaseLayout>
