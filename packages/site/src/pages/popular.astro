---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookmarkItem from '../components/BookmarkItem.astro';
import ViewControls from '../components/ViewControls.astro';
import { collectTagsInBookmarks, siteData, sortPopularBookmarks } from '../lib/data.js';

const sorted = sortPopularBookmarks(siteData.allBookmarks);
const tags = collectTagsInBookmarks(sorted);
---

<BaseLayout
  title="Popular Bookmarks"
  description="Most saved links ranked by unique contributor count"
  activeNav="popular"
  indexForSearch={false}
>
  <header class="page-header">
    <h1 class="page-title">Popular</h1>
    <p class="page-subtitle">
      {sorted.length} unique bookmark{sorted.length === 1 ? '' : 's'} ranked by unique saves across folders.
    </p>
  </header>

  <ViewControls tags={tags} />

  {sorted.length > 0 ? (
    <div
      class="bookmark-collection"
      data-bookmark-collection
      data-view={siteData.config.theme.defaultView}
    >
      {sorted.map((bm) => (
        <BookmarkItem bookmark={bm} showFolder={true} />
      ))}
    </div>
  ) : (
    <div class="empty-state">No bookmarks yet.</div>
  )}
</BaseLayout>
