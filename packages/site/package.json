{
  "name": "@glyphrig/site",
  "version": "0.5.1",
  "description": "Astro Editorial Digital Garden theme for Glyphrig static bookmark directories.",
  "license": "MIT",
  "homepage": "https://github.com/Glyphrig/Glyphrig#readme",
  "bugs": {
    "url": "https://github.com/Glyphrig/Glyphrig/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glyphrig/Glyphrig.git",
    "directory": "packages/site"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro.config.mjs": "./astro.config.mjs"
  },
  "files": [
    "astro.config.mjs",
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@glyphrig/core": "workspace:*",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
